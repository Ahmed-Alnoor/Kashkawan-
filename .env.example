# ---------------------------------------------------------------------------
# Kashkawan Cafeteria — environment
#
# Copy this file to `.env.local` for development, or paste the values into your
# host's environment settings (Vercel: Project → Settings → Environment
# Variables). Never commit real keys — `.env.local` is git-ignored.
# ---------------------------------------------------------------------------

# The public origin of the site. Used for canonical URLs, the sitemap, Open
# Graph tags and links inside the order emails. No trailing slash.
# On Vercel this falls back to the deployment URL automatically, so it is only
# strictly required for a custom domain.
NEXT_PUBLIC_SITE_URL=https://kashkawan.ae


# ---------------------------------------------------------------------------
# Order emails (Resend) — see SETUP.md
#
# The site works with these left blank: orders still validate, still get an
# order reference, and the confirmation page tells the customer to phone the
# reference through. Fill all three in to switch email on.
# ---------------------------------------------------------------------------

# API key from https://resend.com/api-keys — starts with "re_".
RESEND_API_KEY=

# The "from" address. The domain MUST be verified in Resend first.
# Format: "Display Name <address@your-verified-domain>"
ORDER_EMAIL_FROM=Kashkawan Cafeteria <orders@kashkawan.ae>

# Where new orders are delivered. Comma-separate for more than one recipient.
ORDER_EMAIL_TO=branch@kashkawan.ae

# Optional. The address customers reply to on their confirmation email.
# Defaults to the first ORDER_EMAIL_TO address.
ORDER_EMAIL_REPLY_TO=


# ---------------------------------------------------------------------------
# Order channel
#
# "api"      (default) — orders POST to /api/orders and are emailed. Needs a
#                        Node host.
# "whatsapp"           — orders open a pre-filled WhatsApp message to the
#                        branch. Used automatically by the GitHub Pages build,
#                        which has no server. See SETUP.md.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ORDER_CHANNEL=api

# Path prefix when the site is served from a subfolder, e.g. a GitHub project
# site at /<repo>. Left empty for a custom domain. The Pages workflow sets this
# for you.
NEXT_PUBLIC_BASE_PATH=
